`timescale 1ns/1ps

module full_adder_tb;

reg A;
reg B;
reg Cin;

wire Sum;
wire Cout;

// Instantiate the Full Adder
full_adder uut (
    .A(A),
    .B(B),
    .Cin(Cin),
    .Sum(Sum),
    .Cout(Cout)
);

initial begin

    $display("A B Cin | Sum Cout");
    $monitor("%b %b  %b  |  %b    %b", A, B, Cin, Sum, Cout);

    {A,B,Cin}=3'b000; #10;
    {A,B,Cin}=3'b001; #10;
    {A,B,Cin}=3'b010; #10;
    {A,B,Cin}=3'b011; #10;
    {A,B,Cin}=3'b100; #10;
    {A,B,Cin}=3'b101; #10;
    {A,B,Cin}=3'b110; #10;
    {A,B,Cin}=3'b111; #10;

    $finish;

end

endmodule